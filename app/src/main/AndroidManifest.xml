<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      volzz は <uses-permission> を一つも必要としない。
        ・メディア操作 : AudioManager#dispatchMediaKeyEvent  (権限不要)
        ・音量操作     : AudioManager#adjustSuggestedStreamVolume (権限不要)
        ・キーの横取り : アクセシビリティサービス (ユーザーが設定画面で有効化)
      BIND_ACCESSIBILITY_SERVICE は「システムだけがこのサービスに接続できる」
      ことを宣言する保護用で、アプリが要求する権限ではない。
    -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".VolzzService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
