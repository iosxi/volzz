<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      volzz が要求する権限は VIBRATE ひとつだけ。
        ・メディア操作 : AudioManager#dispatchMediaKeyEvent  (権限不要)
        ・音量操作     : AudioManager#adjustSuggestedStreamVolume (権限不要)
        ・キーの横取り : アクセシビリティサービス (ユーザーが設定画面で有効化)
        ・曲送りの合図 : Vibrator#vibrate  ← ここだけ権限が要る
      VIBRATE は保護レベル normal（インストール時に自動で付き、許可を尋ねる
      ダイアログも出ない）。振動以外には何もできない権限で、v7 で曲送りの
      手応えを出すために足した。設定でオフにもできる。
      MODIFY_AUDIO_SETTINGS は細かい音量（ハード段階より細かく刻む）に使う。
      全体のミックスに負のゲインを掛ける音声エフェクトを作るのに要る。
      保護レベルは normal で、こちらも許可を尋ねるダイアログは出ない。
      BIND_ACCESSIBILITY_SERVICE は「システムだけがこのサービスに接続できる」
      ことを宣言する保護用で、アプリが要求する権限ではない。
    -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".VolzzService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
